# Copy to .env.local for local; set the same keys in Vercel → Project → Settings → Environment Variables.

# --- Scuup / research Supabase (NOT the Playerscope sports app) ---
# Dashboard: https://supabase.com/dashboard/project/aierpcwlkmvyojnaksvr
NEXT_PUBLIC_SUPABASE_URL=https://aierpcwlkmvyojnaksvr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cookie signing for Blaast sessions (required in production — do not reuse service role)
BLAAST_AUTH_SECRET=

# Seeded owner on cold start (Vercel /tmp). Required for first login in prod.
BLAAST_OWNER_EMAIL=
BLAAST_OWNER_PASSWORD=
BLAAST_OWNER_NAME=

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional vision enrich
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
